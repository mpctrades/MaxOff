# PostgreSQL connection used by Prisma during local development.
# Copy this file to .env and adjust the user, port, and database for your machine.
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/maxoff_dev?schema=public"

# The access scopes the app requests, as a comma-separated list.
#
# Must stay identical to `scopes` in shopify.app.toml. The toml is what Shopify
# actually grants at token exchange; this variable is what `shopifyApp()` reads
# (app/shopify.server.ts) to validate the session's scopes and to know when to
# re-request them. Leaving it unset leaves the library with `scopes: undefined`,
# which installs fine and then cannot tell that a granted scope has gone missing.
SCOPES="write_discounts,read_discounts,read_products"
