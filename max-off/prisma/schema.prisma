// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  // Postgres, not SQLite, from 14 Sep 2026 — chosen for production because the
  // Session table is what keeps merchants installed. A SQLite file inside the
  // container is wiped on every redeploy, which logs every merchant out and
  // makes them reinstall; that is an App Store review failure, not a bug report.
  //
  // Prisma cannot take `provider` from an env var, so dev and production run the
  // same engine. That is the point: SQLite and Postgres disagree about case
  // sensitivity in LIKE, and a dev database that behaves differently from the
  // real one is how a search that works locally ships broken.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// --- MaxOff models (BUILD-SPEC §3.4) ---

model CappedDiscount {
  id                String   @id @default(cuid())
  shop              String
  discountGid       String   @unique      // gid://shopify/DiscountCodeNode/…
  method            String                // "code" | "automatic"   (V1: always "code")
  code              String?
  title             String?
  percentage        Int                   // whole percent, 1–100
  capMinor          Int                   // cap in minor units, e.g. 15000
  currencyCode      String                // "USD" | "EUR"
  scope             String   @default("order")   // "order" | "item" | "collection" (V1: order)
  checkoutNote      String?
  startsAt          DateTime
  endsAt            DateTime?
  status            String                // "active"|"scheduled"|"paused"|"expired"
  usageLimit        Int?
  oncePerCustomer   Boolean  @default(true)
  combinesShipping  Boolean  @default(true)
  combinesProduct   Boolean  @default(false)
  combinesOrder     Boolean  @default(false)
  timesUsed         Int      @default(0)
  keptMinor         Int      @default(0)   // running total, denormalised for the list
  givenMinor        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  events            CapEvent[]

  @@index([shop, status])
}

model CapEvent {
  id                 String   @id @default(cuid())
  shop               String
  cappedDiscountId   String
  discount           CappedDiscount @relation(fields: [cappedDiscountId], references: [id], onDelete: Cascade)
  orderGid           String   @unique
  orderName          String                // "#1042"
  subtotalMinor      Int
  uncappedMinor      Int                   // what the raw percentage would have given
  givenMinor         Int
  keptMinor          Int
  occurredAt         DateTime

  @@index([shop, occurredAt])
}

model ShopSettings {
  shop                String   @id
  currencyCode        String   @default("USD")
  // The shop's IANA zone, e.g. "Asia/Phnom_Penh". Cached from Shopify like
  // currencyCode is; the store is the authority. Every date a merchant types
  // or reads is interpreted in this zone — see app/lib/timezone.ts.
  timezone            String   @default("UTC")
  rounding            String   @default("cent")   // "cent" | "down"
  defaultCheckoutNote String   @default("Discount capped at maximum amount")
  plan                String   @default("free")   // "free" | "growth" | "pro"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // --- Defaults for new discounts ---
  // These only prefill the Create new form. Nothing here reaches a discount
  // that already exists, which is the whole difference between this block and
  // `rounding` above. The column defaults are the same values
  // `initialDiscountFormState` used before this block existed, so a shop that
  // never opens Settings sees the form it always saw.
  defaultScope            String  @default("order")   // "order" | "item" | "collection"
  defaultOncePerCustomer  Boolean @default(true)
  defaultCombinesProduct  Boolean @default(false)
  defaultCombinesOrder    Boolean @default(false)
  defaultCombinesShipping Boolean @default(true)

  // Beyond BUILD-SPEC §3.4 — added 10 Sep 2026 so the Home setup guide can be stateful.
  // All nullable and additive; no destructive migration. Flagged to Sophea for sign-off.
  setupGuideDismissedAt     DateTime?   // "Hide" button on the setup guide card
  lastCartTestAt            DateTime?   // step 3, "Test it on a big cart"
  lastCartTestSubtotalMinor Int?
  lastCartTestCappedMinor   Int?

  // When this shop was first seen with more active discounts than its plan
  // allows — set by the Home loader, cleared the moment it is back inside the
  // allowance. Null means "not over". The grace period runs from this instant,
  // not from the downgrade itself: Shopify does not tell us when a plan drops,
  // so the first time we notice is the fairest clock we have.
  // See app/lib/plan-grace.ts.
  overLimitSince DateTime?
}
