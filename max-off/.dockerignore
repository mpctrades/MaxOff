.cache
build
node_modules

# Never bake secrets or local state into an image. `.env` here would put the
# app secret inside a layer that anyone who can pull the image can read, and
# the SQLite file is a leftover from before Postgres — copying it in would
# ship dev sessions to production.
.env
.env.*
prisma/dev.sqlite
prisma/dev.sqlite-journal
.shopify
.react-router
.git
.claude
